# CreditPulse Environment Configuration
# Copy this file to .env and fill in the values

# Server Configuration
PORT=5000
NODE_ENV=development
DEMO_MODE=true

# Razorpay Configuration (Required for production, optional for demo)
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# Merchant Configuration
MERCHANT_NAME=Your Merchant Name

# AI Service Configuration (for Copilot feature)
OPENAI_API_KEY=your_openai_api_key_here

# Database Configuration
DATABASE_PATH=./backend/db/creditpulse.db

# Frontend Configuration
VITE_API_URL=http://localhost:5000

# Demo/Seed Configuration
SEED_LINK_COUNT=5
